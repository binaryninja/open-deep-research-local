# --- Local model via Ollama's OpenAI-compatible endpoint ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# All four model roles -> local model served by Ollama (see README Quickstart)
SUMMARIZATION_MODEL=openai:qwen3.6-odr
RESEARCH_MODEL=openai:qwen3.6-odr
COMPRESSION_MODEL=openai:qwen3.6-odr
FINAL_REPORT_MODEL=openai:qwen3.6-odr

SUMMARIZATION_MODEL_MAX_TOKENS=4096
RESEARCH_MODEL_MAX_TOKENS=8192
COMPRESSION_MODEL_MAX_TOKENS=8192
FINAL_REPORT_MODEL_MAX_TOKENS=10000

# --- Search: DuckDuckGo backend (no API key required) ---
SEARCH_API=duckduckgo
# Or use Tavily (cleaner results, free tier available):
# SEARCH_API=tavily
# TAVILY_API_KEY=

# --- Headless operation & local-hardware limits ---
ALLOW_CLARIFICATION=false
MAX_CONCURRENT_RESEARCH_UNITS=2
MAX_RESEARCHER_ITERATIONS=3
MAX_REACT_TOOL_CALLS=6
MAX_CONTENT_LENGTH=8000

GET_API_KEYS_FROM_CONFIG=false

# --- Cloud providers (optional, not needed for local operation) ---
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# LANGSMITH_TRACING=
